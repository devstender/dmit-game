::hook key-plan-route-route-hook
@fallback main-choice
@continue main-choice
::end

::extend key-plan-route-route-hook
@when CHAPTER_1_DID_NOT_APOLOGIZE_TO_MISHGAN
@priority 300
@start mishgan-bad-1
::end

::extend key-plan-route-route-hook
@when CHAPTER_1_APOLOGIZED_TO_MISHGAN
@priority 200
@start mishgan-apology-1
::end

::extend key-plan-route-route-hook
@when CHAPTER_1_HELPED_MISHGAN
@priority 100
@start mishgan-helped-1
::end

