@effect-next experience 6
@effect-next flag CHAPTER_1_SMALL_SCHOOL_INFILTRATION_ROUTE_SELECTED
@next infiltration-mode-dispatch
::end

::hook infiltration-mode-dispatch
@fallback infiltration-high-suspicion-prelude
@continue infiltration-high-suspicion-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_ESCORT
@priority 800
@start escort-route-start
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_HARDEST
@priority 700
@start infiltration-hardest-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_HIGH_SUSPICION
@priority 600
@start infiltration-high-suspicion-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_NOISY
@priority 500
@start infiltration-noisy-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_SUSPICIOUS
@priority 400
@start infiltration-suspicious-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_TIMER_180
@priority 300
@start infiltration-timer-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_EASY
@priority 200
@start infiltration-easy-prelude
::end

::extend infiltration-mode-dispatch
@when INFILTRATION_MODE_NORMAL
@priority 100
@start infiltration-normal-prelude
::end

