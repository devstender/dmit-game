::hook exit-phone-alert-route
@fallback exit-party-route
@continue exit-party-route
::end

::extend exit-phone-alert-route
@when MAFIA_CONTACT_ALERTED
@priority 100
@start exit-alert-holder-route
::end

::hook exit-alert-holder-route
@fallback exit-party-route
@continue exit-party-route
::end

::extend exit-alert-holder-route
@when BLACK_PHONE_DESTROYED
@priority 400
@start exit-party-route
::end

::extend exit-alert-holder-route
@when BLACK_PHONE_CONFISCATED
@priority 300
@start exit-party-route
::end

::extend exit-alert-holder-route
@when BLACK_PHONE_LEFT_AT_SCHOOL
@priority 200
@start exit-party-route
::end

::extend exit-alert-holder-route
@when DMIT_HAS_BLACK_PHONE
@unless BLACK_PHONE_CONFISCATED
@unless BLACK_PHONE_DESTROYED
@unless BLACK_PHONE_LEFT_AT_SCHOOL
@priority 100
@start black-phone-warning-dmit
::end

::phone black-phone-warning-dmit
@bg school-dark-vaz
@cast Дмит
@contact Неизвестный номер
@time 22:48
@notify black-phone-vibration

Неизвестный номер: Не выходи через главный вход.
@next black-phone-warning-dmit__1
::end

::phone black-phone-warning-dmit__1
@cast Дмит
@contact Неизвестный номер
@time 22:48

Дмит: Ты кто?
@next black-phone-warning-dmit__2
::end

::phone black-phone-warning-dmit__2
@cast Дмит
@contact Неизвестный номер
@time 22:48

Неизвестный номер: У тебя две минуты.
@effect-next flag BLACK_PHONE_WARNED_ABOUT_MAIN_EXIT
@next exit-party-route
::end

::hook exit-party-route
@fallback exit-junction-together
@continue exit-junction-together
::end

::extend exit-party-route
@when DMIT_RETURNED_FOR_VADIM
@priority 300
@start exit-junction-together
::end

::extend exit-party-route
@when DMIT_DOUBLE_ABANDONMENT
@priority 200
@start exit-junction-alone
::end

::extend exit-party-route
@when DMIT_ABANDONED_VADIM
@priority 100
@start exit-junction-alone
::end

