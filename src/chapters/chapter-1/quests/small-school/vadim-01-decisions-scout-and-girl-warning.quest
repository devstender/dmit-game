::hook risk-route-route-hook
@fallback entry-main-talk-1
@continue entry-main-talk-1
::end

::extend risk-route-route-hook
@when MATVEY_CREW_MAY_FIND_SCHOOL
@priority 200
@start matvey-scout-1
::end

::extend risk-route-route-hook
@when UNKNOWN_GIRL_INTEREST
@priority 100
@start unknown-phone-1
::end

